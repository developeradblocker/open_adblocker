{
  "name": "Free Adblocker for Chrome by Open Adblocker",
  "description": "Free Adblocker for Chrome by Open Adblocker",
  "manifest_version": 3,
  "minimum_chrome_version": "110.0",
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_icon": "icons/extension/icon_16.png",
    "default_title": "Open Adblocker",
    "default_popup": "popup/index.html"
  },
  "icons": {
    "16": "icons/extension/icon_16.png",
    "48": "icons/extension/icon_48.png",
    "128": "icons/extension/icon_128.png"
  },
  "content_scripts": [
    {
      "all_frames": false,
      "js": [
        "content/tswebextension/content-script.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "match_about_blank": true,
      "run_at": "document_idle"
    },
    {
      "all_frames": false,
      "js": [
        "content/content.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "match_about_blank": true,
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "/content/manual-blocking/index.html",
        "/content/rate-us/index.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "resources": [
        "web-accessible-resources/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "permissions": [
    "scripting",
    "webRequest",
    "webNavigation",
    "storage",
    "management",
    "declarativeNetRequest",
    "alarms",
    "tabs",
    "cookies"
  ],
  "optional_permissions": [
    "privacy"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_page": "settings/index.html"
}
