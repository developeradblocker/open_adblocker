{
  "name": "open-adblocker",
  "version": "1.6.5",
  "type": "module",
  "scripts": {
    "build:dev:chrome": "webpack --config webpack/webpack.config.js --mode=development --env BROWSER=chrome",
    "build:prod:chrome": "webpack --config webpack/webpack.config.js --mode=production --env BROWSER=chrome",
    "build:dev:edge": "webpack --config webpack/webpack.config.js --mode=development --env BROWSER=edge",
    "build:dev:chrome:watch": "npm run build:dev:chrome -- --env HOT_RELOAD=true --watch",
    "build:dev:edge:watch": "npm run build:dev:edge -- --env HOT_RELOAD=true --watch",
    "build:prod:edge": "webpack --config webpack/webpack.config.js --mode=production --env BROWSER=edge",
    "build:dev:all": "npm run build:dev:chrome && npm run build:dev:edge",
    "build:prod:all": "npm run build:prod:chrome && npm run build:prod:edge",
    "sync-rules": "npm update @adguard/dnr-rulesets && tsx tools/sync-rules.ts",
    "disclaimer": "npm run lint | tsx tools/add-disclaimer.ts",
    "test": "jest",
    "lint": "npx eslint ./",
    "lint:fix": "npx eslint ./ --fix",
    "test:watch": "npm run test -- --watch",
    "test:coverage": "jest --coverage --no-cache",
    "prepare": "husky",
    "server": "node server/index.mjs"
  },
  "dependencies": {
    "@adguard/agtree": "^4.1.1",
    "@adguard/tsurlfilter": "^5.0.1",
    "@adguard/tswebextension": "^4.1.2",
    "ace-builds": "^1.43.4",
    "inversify": "^7.10.4",
    "pinia": "^3.0.3",
    "reflect-metadata": "^0.2.2",
    "uuid": "^13.0.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.33",
    "vue-inline-svg": "^4.0.1",
    "vue-router": "^4.6.3",
    "vue3-ace-editor": "^2.2.4",
    "vue3-popper": "^1.5.0",
    "zod": "^4.4.3"
  },
  "license": "GPL-3.0",
  "devDependencies": {
    "@adguard/dnr-rulesets": "~4.2",
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-transform-runtime": "^7.28.3",
    "@babel/preset-env": "^7.26.9",
    "@babel/runtime": "^7.27.0",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.1.24",
    "@types/jest": "^29.5.10",
    "@types/node": "^24.7.2",
    "@types/webpack-env": "^1.18.8",
    "@vue/test-utils": "^2.4.6",
    "@vue/vue3-jest": "^29.2.5",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.2",
    "dotenv-webpack": "^8.1.1",
    "eslint": "^10.4.0",
    "eslint-plugin-jsdoc": "^63.0.0",
    "eslint-plugin-vue": "^10.9.1",
    "filemanager-webpack-plugin": "^10.0.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.1.2",
    "jest-fetch-mock": "^3.0.3",
    "less": "^4.3.0",
    "less-loader": "^12.3.0",
    "openai": "^6.39.0",
    "ts-jest": "^29.4.5",
    "ts-loader": "^9.5.4",
    "tsx": "^4.20.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vue-loader": "^17.4.2",
    "vue-style-loader": "^4.1.3",
    "webpack": "^5.106.2",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1",
    "ws": "^8.20.1"
  }
}
