{
  "name": "Open Adblocker",
  "description": "Get the best open source ad blocker - Block ads in one click",
  "manifest_version": 3,
  "minimum_chrome_version": "110.0",
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_icon": "icons/extension/icon_16.png",
    "default_title": "Open Adblocker",
    "default_popup": "popup/index.html"
  },
  "icons": {
    "16": "icons/extension/icon_16.png",
    "48": "icons/extension/icon_48.png",
    "128": "icons/extension/icon_128.png"
  },
  "content_scripts": [
    {
      "all_frames": true,
      "js": [
        "content/content-script.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "scripting",
    "webRequest",
    "webNavigation",
    "storage",
    "management",
    "declarativeNetRequest",
    "alarms",
    "tabs"
  ],
  "optional_permissions": [
    "privacy"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_page": "settings/index.html"
}
